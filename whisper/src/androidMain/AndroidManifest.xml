<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!--
            The whisper.cpp speech engine runs in this isolated process; what
            the isolation buys, and the process's real name, are stated on
            WhisperEngineService. WhisperEngineManifestTest pins the two
            attributes that make the containment.
        -->
        <service
            android:name="coredevices.whisper.WhisperEngineService"
            android:exported="false"
            android:isolatedProcess="true"
            android:process=":whisper" />
    </application>
</manifest>
